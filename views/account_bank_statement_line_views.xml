<odoo>

    <record id="yg_bank_reconcile_list" model="ir.ui.view">
        <field name="name">account.bank.statement.line.list.yg.conciliacion</field>
        <field name="model">account.bank.statement.line</field>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <list string="Conciliación bancaria" create="0" edit="0" default_order="date, id">
                <field name="company_id" column_invisible="1"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="date"/>
                <field name="journal_id" optional="hide"/>
                <field name="payment_ref" string="Concepto"/>
                <field name="ref" string="Comprobante" optional="show"/>
                <field name="partner_id" optional="show"/>
                <field name="amount" sum="Total"/>
                <field name="is_reconciled" string="Conciliado" optional="show"/>
                <button name="action_yg_conciliar" type="object" string="Conciliar" icon="fa-check"
                        invisible="is_reconciled"/>
                <button name="action_undo_reconciliation" type="object" string="Deshacer" icon="fa-undo"
                        invisible="not is_reconciled"
                        confirm="Se deshace la conciliación y el movimiento vuelve a la cuenta transitoria. ¿Seguís?"/>
            </list>
        </field>
    </record>

    <record id="yg_bank_reconcile_search" model="ir.ui.view">
        <field name="name">account.bank.statement.line.search.yg.conciliacion</field>
        <field name="model">account.bank.statement.line</field>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <search string="Conciliación bancaria">
                <field name="payment_ref" string="Concepto"/>
                <field name="partner_id"/>
                <field name="journal_id"/>
                <field name="amount"/>
                <filter name="pendientes" string="Pendientes" domain="[('is_reconciled', '=', False)]"/>
                <filter name="conciliados" string="Conciliados" domain="[('is_reconciled', '=', True)]"/>
                <separator/>
                <filter name="por_banco" string="Banco" context="{'group_by': 'journal_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_yg_bank_reconcile" model="ir.actions.act_window">
        <field name="name">Conciliación bancaria</field>
        <field name="res_model">account.bank.statement.line</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="yg_bank_reconcile_list"/>
        <field name="search_view_id" ref="yg_bank_reconcile_search"/>
        <field name="context">{'search_default_pendientes': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No hay movimientos pendientes de conciliar.</p>
            <p>Importá el extracto del banco desde el tablero y conciliá cada movimiento con su factura, pago o cuenta.</p>
        </field>
    </record>

    <menuitem id="menu_yg_bank_reconcile" name="Conciliación bancaria"
              parent="account.account_transactions_menu" action="action_yg_bank_reconcile"
              sequence="5" groups="account.group_account_user"/>

    <!-- Tablero: botón "Conciliar" en la tarjeta de cada banco -->
    <record id="account_journal_dashboard_kanban_view_yg_bank_reconcile" model="ir.ui.view">
        <field name="name">account.journal.dashboard.kanban.yg.bank.reconcile</field>
        <field name="model">account.journal</field>
        <field name="inherit_id" ref="account.account_journal_dashboard_kanban_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='bank_cash_buttons']/button[@id='all_transactions_btn']" position="after">
                <button t-if="journal_type == 'bank'" type="object" name="action_yg_bank_reconcile"
                        class="btn btn-secondary" groups="account.group_account_user">Conciliar</button>
            </xpath>
        </field>
    </record>

</odoo>
