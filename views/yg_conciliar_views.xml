<odoo>

    <record id="yg_conciliar_form" model="ir.ui.view">
        <field name="name">yg.conciliar.form</field>
        <field name="model">yg.conciliar</field>
        <field name="arch" type="xml">
            <form string="Conciliar movimiento">
                <field name="st_line_id" invisible="1"/>
                <field name="company_id" invisible="1"/>
                <field name="currency_id" invisible="1"/>
                <group>
                    <group string="Movimiento del banco">
                        <field name="journal_id"/>
                        <field name="fecha"/>
                        <field name="concepto"/>
                        <field name="comprobante"/>
                    </group>
                    <group string="Asignación">
                        <field name="monto"/>
                        <field name="asignado"/>
                        <field name="falta" decoration-bf="1"/>
                        <field name="regla_id" invisible="not regla_id"/>
                    </group>
                </group>
                <separator string="Partidas pendientes (tildá «Usar» en las que corresponden)"/>
                <field name="partida_ids" nolabel="1">
                    <list editable="bottom" create="0" delete="0">
                        <field name="currency_id" column_invisible="1"/>
                        <field name="aml_id" column_invisible="1"/>
                        <field name="seleccionar"/>
                        <field name="fecha"/>
                        <field name="vencimiento"/>
                        <field name="comprobante"/>
                        <field name="contacto"/>
                        <field name="cuenta"/>
                        <field name="etiqueta" optional="hide"/>
                        <field name="pendiente" sum="Total"/>
                        <field name="importe" readonly="not seleccionar" sum="Total"/>
                    </list>
                </field>
                <group>
                    <field name="agregar_aml_id" options="{'no_create': True}"/>
                </group>
                <separator string="A cuenta (impuesto al cheque, comisiones, intereses…)"/>
                <field name="cuenta_ids" nolabel="1">
                    <list editable="bottom">
                        <field name="currency_id" column_invisible="1"/>
                        <field name="account_id" options="{'no_create': True}"/>
                        <field name="name"/>
                        <field name="partner_id" optional="hide"/>
                        <field name="importe" sum="Total"/>
                    </list>
                </field>
                <separator string="Observaciones (quedan en el historial)"/>
                <field name="observacion" nolabel="1" placeholder="Ej.: cheque 1234 de Roberto Frenos, entregado el 15/09"/>
                <footer>
                    <button string="Conciliar" name="action_conciliar" type="object" class="btn-primary"/>
                    <button string="Conciliar y siguiente" name="action_conciliar_y_siguiente" type="object" class="btn-primary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
